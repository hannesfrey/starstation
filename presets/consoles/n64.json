{
  "id": "n64",
  "name": "Nintendo 64",
  "short": "N64",
  "order": 30,
  "icon": "console-n64",
  "emulator": "retroarch",
  "core": "mupen64plus_next",
  "launch": {
    "args": [
      "-L",
      "{emu}/cores/{core}_libretro.dll",
      "--appendconfig",
      "{config}/retroarch/{console}.cfg|{config}/retroarch/achievements.cfg",
      "-f",
      "{launch}"
    ]
  },
  "extensions": [
    ".z64",
    ".n64",
    ".v64",
    ".zip",
    ".7z"
  ],
  "bios": {
    "files": [
      {
        "label": "Mupen64Plus-Next core",
        "match": "",
        "path": "{emu}/cores/{core}_libretro.dll",
        "required": true,
        "fix": {
          "label": "Install the Mupen64Plus-Next core",
          "command": "install-core",
          "arg": "mupen64plus_next"
        }
      }
    ]
  },
  "gameId": {
    "method": "n64-header"
  },
  "saves": {
    "dir": "{saves}"
  },
  "import": {
    "roms": [
      "n64"
    ]
  },
  "config": [
    {
      "type": "write",
      "file": "{config}/retroarch/{console}.cfg",
      "lines": [
        "savefile_directory = \"{saves}\"",
        "savestate_directory = \"{saves}/states\"",
        "system_directory = \"{bios}\"",
        "screenshot_directory = \"{screenshots}\"",
        "sort_savefiles_enable = \"false\"",
        "sort_savestates_enable = \"false\"",
        "quit_on_close_content = \"1\"",
        "video_fullscreen = \"true\"",
        "pause_nonactive = \"true\"",
        "savestate_auto_save = \"true\"",
        "savestate_auto_load = \"{resume}\"",
        "input_joypad_driver = \"{rajoypad}\"",
        "input_autodetect_enable = \"true\"",
        "input_screenshot = \"f12\"",
        "config_save_on_exit = \"false\"",
        "video_driver = \"d3d11\"",
        "video_scale_integer = \"{raint}\"",
        "video_smooth = \"false\"",
        "video_shader_enable = \"{crt}\"",
        "core_options_path = \"{config}/retroarch/{console}-core-options.cfg\"",
        "global_core_options = \"true\"",
        "netplay_use_mitm_server = \"{nprelayon}\"",
        "netplay_mitm_server = \"{nprelay}\"",
        "video_windowed_fullscreen = \"true\"",
        "input_save_state = \"f2\"",
        "input_load_state = \"f4\"",
        "input_menu_toggle_gamepad_combo = \"0\"",
        "input_player1_joypad_index = \"{rapad1}\"",
        "input_player2_joypad_index = \"{rapad2}\"",
        "input_player3_joypad_index = \"{rapad3}\"",
        "input_player4_joypad_index = \"{rapad4}\""
      ]
    },
    {
      "type": "mkdir",
      "path": "{saves}/states"
    },
    {
      "type": "write",
      "file": "{config}/retroarch/{console}-core-options.cfg",
      "lines": [
        "mupen64plus-43screensize = \"{n64res}\"",
        "mupen64plus-txHiresEnable = \"{n64hires}\""
      ]
    }
  ],
  "quickResume": true,
  "netplay": true,
  "backup": [
    {
      "path": "{saves}/{basename}.*"
    }
  ],
  "resume": {
    "state": "{saves}/states/{basename}.state.auto",
    "args": []
  },
  "graphics": {
    "original": {
      "vars": {
        "raint": "false",
        "n64res": "640x480"
      }
    },
    "enhanced": {
      "vars": {
        "raint": "false",
        "n64res": "1440x1080"
      }
    },
    "max": {
      "vars": {
        "raint": "false",
        "n64res": "2880x2160"
      }
    }
  },
  "crt": {
    "on": {
      "vars": {
        "crt": "true"
      },
      "args": [
        "--set-shader",
        "{emu}/shaders/shaders_slang/crt/crt-geom.slangp"
      ]
    },
    "off": {
      "vars": {
        "crt": "false"
      }
    }
  },
  "mods": {
    "targets": [
      {
        "id": "textures",
        "label": "Texture pack",
        "dir": "{bios}/Mupen64plus/hires_texture/{romname}",
        "match": "\\.(png|dds|jpg|jpeg|webp)$",
        "enabled": {
          "vars": {
            "n64hires": "True"
          }
        },
        "disabled": {
          "vars": {
            "n64hires": "False"
          }
        }
      }
    ]
  },
  "netplayCore": "Mupen64Plus-Next",
  "achievements": {
    "on": [
      {
        "type": "write",
        "file": "{config}/retroarch/achievements.cfg",
        "lines": [
          "cheevos_enable = \"true\"",
          "cheevos_username = \"{rauser}\"",
          "cheevos_token = \"{ratoken}\"",
          "cheevos_hardcore_mode_enable = \"false\""
        ]
      }
    ],
    "off": [
      {
        "type": "write",
        "file": "{config}/retroarch/achievements.cfg",
        "lines": [
          "# not logged in to RetroAchievements through Starstation"
        ]
      }
    ]
  }
}
