{
  "id": "xbox360",
  "name": "Xbox 360",
  "short": "Xbox 360",
  "order": 130,
  "icon": "console-xbox360",
  "emulator": "xenia",
  "launch": {
    "args": [
      "--fullscreen",
      "{launch}"
    ]
  },
  "extensions": [
    ".iso",
    ".xex",
    ".zar"
  ],
  "games": {
    "folderMarker": "default.xex",
    "folderLaunch": "default.xex"
  },
  "gameId": {
    "method": "x360-xex"
  },
  "saves": {
    "dir": "{saves}",
    "note": "Xenia keeps saves in its content folder; the saves folder links there."
  },
  "import": {
    "roms": [
      "xbox360",
      "x360"
    ]
  },
  "config": [
    {
      "type": "link",
      "path": "{saves}/content",
      "target": "{emu}/content"
    },
    {
      "type": "mkdir",
      "path": "{emu}/screenshots"
    },
    {
      "type": "link",
      "path": "{screenshots}/xenia",
      "target": "{emu}/screenshots"
    },
    {
      "type": "ini",
      "file": "{emu}/xenia-canary.config.toml",
      "set": {
        "HID": {
          "guide_button": "false"
        }
      },
      "ifExists": true
    }
  ],
  "quickResume": false,
  "shaderHint": true,
  "notes": "No save states in Xenia, so no quick resume. Extracted games: a folder with default.xex.",
  "backup": [
    {
      "path": "{saves}/content",
      "shared": true
    }
  ],
  "graphics": {
    "original": {
      "steps": [
        {
          "type": "ini",
          "file": "{emu}/xenia-canary.config.toml",
          "set": {
            "GPU": {
              "draw_resolution_scale_x": "1",
              "draw_resolution_scale_y": "1"
            }
          },
          "ifExists": true
        }
      ]
    },
    "enhanced": {
      "steps": [
        {
          "type": "ini",
          "file": "{emu}/xenia-canary.config.toml",
          "set": {
            "GPU": {
              "draw_resolution_scale_x": "2",
              "draw_resolution_scale_y": "2"
            }
          },
          "ifExists": true
        }
      ]
    },
    "max": {
      "steps": [
        {
          "type": "ini",
          "file": "{emu}/xenia-canary.config.toml",
          "set": {
            "GPU": {
              "draw_resolution_scale_x": "3",
              "draw_resolution_scale_y": "3"
            }
          },
          "ifExists": true
        }
      ]
    }
  }
}
