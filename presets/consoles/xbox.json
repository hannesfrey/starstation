{
  "id": "xbox",
  "name": "Original Xbox",
  "short": "Xbox",
  "order": 120,
  "icon": "box",
  "emulator": "xemu",
  "launch": {
    "args": [
      "-full-screen",
      "-dvd_path",
      "{launch}"
    ]
  },
  "extensions": [
    ".iso",
    ".xiso"
  ],
  "bios": {
    "hint": "xemu needs three files from your own Xbox: the MCPX boot ROM (512 bytes), a flash BIOS (256 KB or 1 MB) and a hard-disk image (.qcow2).",
    "url": "https://xemu.app/docs/required-files/",
    "files": [
      {
        "label": "MCPX boot ROM",
        "match": "\\.bin$",
        "size": [
          512
        ],
        "required": true
      },
      {
        "label": "Xbox flash BIOS",
        "match": "\\.bin$",
        "size": [
          262144,
          1048576
        ],
        "required": true
      },
      {
        "label": "Xbox hard-disk image",
        "match": "\\.qcow2$",
        "required": true
      }
    ],
    "select": [
      {
        "file": "{emu}/xemu.toml",
        "section": "sys.files",
        "key": "bootrom_path",
        "rule": "MCPX boot ROM",
        "fullPath": true,
        "quote": true
      },
      {
        "file": "{emu}/xemu.toml",
        "section": "sys.files",
        "key": "flashrom_path",
        "rule": "Xbox flash BIOS",
        "fullPath": true,
        "quote": true,
        "prefer": "complex|4627"
      },
      {
        "file": "{emu}/xemu.toml",
        "section": "sys.files",
        "key": "hdd_path",
        "rule": "Xbox hard-disk image",
        "fullPath": true,
        "quote": true
      }
    ]
  },
  "gameId": {
    "method": "filename"
  },
  "saves": {
    "dir": "{saves}",
    "note": "Xbox saves live inside the hard-disk image in the BIOS folder."
  },
  "import": {
    "roms": [
      "xbox"
    ]
  },
  "config": [
    {
      "type": "ini",
      "file": "{emu}/xemu.toml",
      "set": {
        "general": {
          "show_welcome": false,
          "screenshot_dir": "'{screenshots}'"
        },
        "display.window": {
          "fullscreen_on_startup": true
        },
        "sys.files": {
          "eeprom_path": "'{bios}\\eeprom.bin'"
        }
      }
    }
  ],
  "quickResume": false,
  "notes": "No quick resume (xemu has no save-on-exit). Saves live inside the hard-disk image, so they are not backed up per game."
}
