{
  "id": "wii",
  "name": "Nintendo Wii",
  "short": "Wii",
  "order": 50,
  "icon": "console-wii",
  "emulator": "dolphin",
  "launch": {
    "args": [
      "-b",
      "-e",
      "{launch}"
    ]
  },
  "extensions": [
    ".iso",
    ".wbfs",
    ".rvz",
    ".wia",
    ".gcz",
    ".ciso",
    ".wad"
  ],
  "gameId": {
    "method": "gc-header"
  },
  "saves": {
    "dir": "{saves}",
    "note": "Dolphin keeps saves in its User folder; the saves folder links there."
  },
  "import": {
    "roms": [
      "wii"
    ]
  },
  "config": [
    {
      "type": "ini",
      "file": "{emu}/User/Config/Dolphin.ini",
      "set": {
        "Display": {
          "Fullscreen": "True"
        },
        "Interface": {
          "ConfirmStop": "False",
          "ShowActiveTitle": "False",
          "PauseOnFocusLost": "True"
        },
        "General": {
          "ISOPaths": "1",
          "ISOPath0": "{games}",
          "UseDiscordPresence": "False"
        },
        "Analytics": {
          "PermissionAsked": "True",
          "Enabled": "False"
        },
        "AutoUpdate": {
          "UpdateTrack": ""
        }
      }
    },
    {
      "type": "link",
      "path": "{saves}/Wii",
      "target": "{emu}/User/Wii"
    },
    {
      "type": "mkdir",
      "path": "{emu}/User/ScreenShots"
    },
    {
      "type": "link",
      "path": "{screenshots}/dolphin",
      "target": "{emu}/User/ScreenShots"
    },
    {
      "type": "ini",
      "file": "{emu}/User/Config/GFX.ini",
      "set": {
        "Settings": {
          "BorderlessFullscreen": "True"
        }
      }
    }
  ],
  "quickResume": false,
  "backup": [
    {
      "path": "{saves}/Wii/title",
      "shared": true
    }
  ],
  "notes": "No quick resume: Dolphin cannot save a state automatically when it closes.",
  "controls": [
    {
      "type": "ini",
      "file": "{emu}/User/Config/WiimoteNew.ini",
      "set": {
        "Wiimote1": {
          "Source": "1",
          "Device": "{dolpad1}",
          "Buttons/A": "{dolA}",
          "Buttons/B": "`Trigger R`",
          "Buttons/1": "{dolX}",
          "Buttons/2": "{dolY}",
          "Buttons/-": "`Back`",
          "Buttons/+": "`Start`",
          "Buttons/Home": "`Thumb L`",
          "D-Pad/Up": "`Pad N`",
          "D-Pad/Down": "`Pad S`",
          "D-Pad/Left": "`Pad W`",
          "D-Pad/Right": "`Pad E`",
          "IR/Up": "`Right Y+`",
          "IR/Down": "`Right Y-`",
          "IR/Left": "`Right X-`",
          "IR/Right": "`Right X+`",
          "Shake/X": "`Thumb R`",
          "Shake/Y": "`Thumb R`",
          "Shake/Z": "`Thumb R`",
          "Extension": "Nunchuk",
          "Nunchuk/Buttons/C": "`Shoulder L`",
          "Nunchuk/Buttons/Z": "`Trigger L`",
          "Nunchuk/Stick/Up": "`Left Y+`",
          "Nunchuk/Stick/Down": "`Left Y-`",
