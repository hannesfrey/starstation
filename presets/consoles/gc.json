{
  "id": "gc",
  "name": "Nintendo GameCube",
  "short": "GameCube",
  "order": 40,
  "icon": "console-gc",
  "emulator": "dolphin",
  "launch": {
    "args": [
      "-b",
      "-e",
      "{launch}"
    ]
  },
  "extensions": [
    ".iso",
    ".gcm",
    ".rvz",
    ".gcz",
    ".ciso",
    ".wia",
    ".m3u"
  ],
  "gameId": {
    "method": "gc-header"
  },
  "saves": {
    "dir": "{saves}",
    "note": "Dolphin keeps saves in its User folder; the saves folder links there."
  },
  "import": {
    "roms": [
      "gc",
      "gamecube",
      "ngc"
    ]
  },
  "config": [
    {
      "type": "ini",
      "file": "{emu}/User/Config/Dolphin.ini",
      "set": {
        "Display": {
          "Fullscreen": "True"
        },
        "Interface": {
          "ConfirmStop": "False",
          "ShowActiveTitle": "False",
          "PauseOnFocusLost": "True"
        },
        "General": {
          "ISOPaths": "1",
          "ISOPath0": "{games}",
          "UseDiscordPresence": "False"
        },
        "Analytics": {
          "PermissionAsked": "True",
          "Enabled": "False"
        },
        "Core": {
          "SIDevice0": "{gcport1}",
          "SIDevice1": "{gcport2}",
          "SIDevice2": "{gcport3}",
          "SIDevice3": "{gcport4}"
        },
        "AutoUpdate": {
          "UpdateTrack": ""
        }
      }
    },
    {
      "type": "link",
      "path": "{saves}/GC",
      "target": "{emu}/User/GC"
    },
    {
      "type": "mkdir",
      "path": "{emu}/User/ScreenShots"
    },
    {
      "type": "link",
      "path": "{screenshots}/dolphin",
      "target": "{emu}/User/ScreenShots"
    },
    {
      "type": "ini",
      "file": "{emu}/User/Config/GFX.ini",
      "set": {
        "Settings": {
          "BorderlessFullscreen": "True"
        }
      }
    }
  ],
  "quickResume": false,
  "backup": [
    {
      "path": "{saves}/GC",
      "shared": true
    }
  ],
  "notes": "No quick resume: Dolphin cannot save a state automatically when it closes.",
  "controls": [
    {
      "type": "ini",
      "file": "{emu}/User/Config/GCPadNew.ini",
      "set": {
        "GCPad1": {
          "Device": "{dolpad1}",
          "Buttons/A": "{dolA1}",
          "Buttons/B": "{dolX1}",
          "Buttons/X": "{dolB1}",
          "Buttons/Y": "{dolY1}",
          "Buttons/Z": "`Shoulder R`",
          "Buttons/Start": "`Start`",
          "Main Stick/Up": "`Left Y+`",
          "Main Stick/Down": "`Left Y-`",
          "Main Stick/Left": "`Left X-`",
          "Main Stick/Right": "`Left X+`",
          "C-Stick/Up": "`Right Y+`",
          "C-Stick/Down": "`Right Y-`",
          "C-Stick/Left": "`Right X-`",
          "C-Stick/Right": "`Right X+`",
          "Triggers/L": "`Trigger L`",
          "Triggers/R": "`Trigger R`",
          "Triggers/L-Analog": "`Trigger L`",
          "Triggers/R-Analog": "`Trigger R`",
          "D-Pad/Up": "`Pad N`",
          "D-Pad/Down": "`Pad S`",
          "D-Pad/Left": "`Pad W`",
          "D-Pad/Right": "`Pad E`",
          "Rumble/Motor": "`Motor L` | `Motor R`"
        },
        "GCPad2": {
          "Device": "{dolpad2}",
          "Buttons/A": "{dolA2}",
          "Buttons/B": "{dolX2}",
          "Buttons/X": "{dolB2}",
          "Buttons/Y": "{dolY2}",
          "Buttons/Z": "`Shoulder R`",
          "Buttons/Start": "`Start`",
          "Main Stick/Up": "`Left Y+`",
          "Main Stick/Down": "`Left Y-`",
          "Main Stick/Left": "`Left X-`",
          "Main Stick/Right": "`Left X+`",
          "C-Stick/Up": "`Right Y+`",
          "C-Stick/Down": "`Right Y-`",
          "C-Stick/Left": "`Right X-`",
          "C-Stick/Right": "`Right X+`",
          "Triggers/L": "`Trigger L`",
          "Triggers/R": "`Trigger R`",
          "Triggers/L-Analog": "`Trigger L`",
          "Triggers/R-Analog": "`Trigger R`",
          "D-Pad/Up": "`Pad N`",
          "D-Pad/Down": "`Pad S`",
          "D-Pad/Left": "`Pad W`",
          "D-Pad/Right": "`Pad E`",
          "Rumble/Motor": "`Motor L` | `Motor R`"
        },
        "GCPad3": {
          "Device": "{dolpad3}",
          "Buttons/A": "{dolA3}",
          "Buttons/B": "{dolX3}",
          "Buttons/X": "{dolB3}",
          "Buttons/Y": "{dolY3}",
          "Buttons/Z": "`Shoulder R`",
          "Buttons/Start": "`Start`",
          "Main Stick/Up": "`Left Y+`",
          "Main Stick/Down": "`Left Y-`",
          "Main Stick/Left": "`Left X-`",
          "Main Stick/Right": "`Left X+`",
          "C-Stick/Up": "`Right Y+`",
          "C-Stick/Down": "`Right Y-`",
          "C-Stick/Left": "`Right X-`",
          "C-Stick/Right": "`Right X+`",
          "Triggers/L": "`Trigger L`",
          "Triggers/R": "`Trigger R`",
          "Triggers/L-Analog": "`Trigger L`",
          "Triggers/R-Analog": "`Trigger R`",
          "D-Pad/Up": "`Pad N`",
          "D-Pad/Down": "`Pad S`",
          "D-Pad/Left": "`Pad W`",
          "D-Pad/Right": "`Pad E`",
          "Rumble/Motor": "`Motor L` | `Motor R`"
        },
        "GCPad4": {
          "Device": "{dolpad4}",
          "Buttons/A": "{dolA4}",
          "Buttons/B": "{dolX4}",
          "Buttons/X": "{dolB4}",
          "Buttons/Y": "{dolY4}",
          "Buttons/Z": "`Shoulder R`",
          "Buttons/Start": "`Start`",
          "Main Stick/Up": "`Left Y+`",
          "Main Stick/Down": "`Left Y-`",
          "Main Stick/Left": "`Left X-`",
          "Main Stick/Right": "`Left X+`",
          "C-Stick/Up": "`Right Y+`",
          "C-Stick/Down": "`Right Y-`",
          "C-Stick/Left": "`Right X-`",
          "C-Stick/Right": "`Right X+`",
          "Triggers/L": "`Trigger L`",
          "Triggers/R": "`Trigger R`",
          "Triggers/L-Analog": "`Trigger L`",
          "Triggers/R-Analog": "`Trigger R`",
          "D-Pad/Up": "`Pad N`",
          "D-Pad/Down": "`Pad S`",
          "D-Pad/Left": "`Pad W`",
          "D-Pad/Right": "`Pad E`",
          "Rumble/Motor": "`Motor L` | `Motor R`"
        }
      }
    },
    {
      "type": "ini",
      "file": "{emu}/User/Config/Hotkeys.ini",
      "set": {
        "Hotkeys": {
          "Device": "DInput/0/Keyboard Mouse",
          "General/Take Screenshot": "F12",
          "General/Stop": "ESCAPE",
          "General/Toggle Pause": "F10",
          "General/Toggle Fullscreen": "@(Alt+RETURN)",
          "Save State/Save State Slot 1": "@(Shift+F1)",
          "Load State/Load State Slot 1": "F1"
        }
      }
    }
  ],
  "graphics": {
    "original": {
      "steps": [
        {
          "type": "ini",
          "file": "{emu}/User/Config/GFX.ini",
          "set": {
            "Settings": {
              "InternalResolution": "1"
            }
          }
        }
      ]
    },
    "enhanced": {
      "steps": [
        {
          "type": "ini",
          "file": "{emu}/User/Config/GFX.ini",
          "set": {
            "Settings": {
              "InternalResolution": "3"
            }
          }
        }
      ]
    },
    "max": {
      "steps": [
        {
          "type": "ini",
          "file": "{emu}/User/Config/GFX.ini",
          "set": {
            "Settings": {
              "InternalResolution": "6"
            }
          }
        }
      ]
    }
  },
  "patches": [
    {
      "id": "widescreen",
      "label": "Widescreen hack",
      "on": {
        "steps": [
          {
            "type": "ini",
            "file": "{emu}/User/Config/GFX.ini",
            "set": {
              "Settings": {
                "wideScreenHack": "True"
              }
            }
          }
        ]
      },
      "off": {
        "steps": [
          {
            "type": "ini",
            "file": "{emu}/User/Config/GFX.ini",
            "set": {
              "Settings": {
                "wideScreenHack": "False"
              }
            }
          }
        ]
      }
    }
  ],
  "mods": {
    "targets": [
      {
        "id": "textures",
        "label": "Texture pack",
        "dir": "{emu}/User/Load/Textures/{serial}",
        "match": "\\.(png|dds|jpg|jpeg|webp)$",
        "enabled": {
          "steps": [
            {
              "type": "ini",
              "file": "{emu}/User/Config/GFX.ini",
              "set": {
                "Settings": {
                  "HiresTextures": "True"
                }
              }
            }
          ]
        },
        "disabled": {
          "steps": [
            {
              "type": "ini",
              "file": "{emu}/User/Config/GFX.ini",
              "set": {
                "Settings": {
                  "HiresTextures": "False"
                }
              }
            }
          ]
        }
      }
    ]
  },
  "achievements": {
    "on": [
      {
        "type": "ini",
        "file": "{emu}/User/Config/RetroAchievements.ini",
        "set": {
          "Achievements": {
            "Enabled": "True",
            "Username": "{rauser}",
            "ApiToken": "{ratoken}"
          }
        }
      }
    ]
  }
}
