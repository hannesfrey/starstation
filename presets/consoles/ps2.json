{
  "id": "ps2",
  "name": "PlayStation 2",
  "short": "PS2",
  "order": 100,
  "icon": "console-ps2",
  "emulator": "pcsx2",
  "launch": {
    "args": [
      "-batch",
      "-fullscreen",
      "--",
      "{launch}"
    ]
  },
  "extensions": [
    ".iso",
    ".chd",
    ".cso",
    ".zso",
    ".gz",
    ".m3u",
    ".elf"
  ],
  "games": {
    "multiDisc": "m3u"
  },
  "bios": {
    "hint": "A PS2 BIOS dump (4 MB .bin, e.g. SCPH-70004).",
    "files": [
      {
        "label": "PS2 BIOS (any region)",
        "match": "\\.(bin|rom0)$",
        "size": [
          4194304
        ],
        "required": true
      }
    ],
    "select": {
      "file": "{emu}/inis/PCSX2.ini",
      "section": "Filenames",
      "key": "BIOS",
      "prefer": "70004|7000[0-9]|EUR|USA"
    }
  },
  "gameId": {
    "method": "ps2-serial",
    "titleDb": {
      "type": "yaml-serial",
      "file": "{emu}/resources/GameIndex.yaml"
    }
  },
  "saves": {
    "dir": "{saves}"
  },
  "config": [
    {
      "type": "ini",
      "file": "{emu}/inis/PCSX2.ini",
      "set": {
        "UI": {
          "SettingsVersion": "1",
          "SetupWizardIncomplete": "false",
          "StartFullscreen": "true",
          "ConfirmShutdown": "false",
          "PauseOnFocusLoss": "true"
        },
        "Folders": {
          "Bios": "{bios}",
          "MemoryCards": "{saves}/memcards",
          "Savestates": "{saves}/sstates",
          "Snapshots": "{screenshots}"
        },
        "GameList": {
          "RecursivePaths": "{games}"
        },
        "EmuCore": {
          "SaveStateOnShutdown": "true"
        },
        "EmuCore/GS": {
          "FullscreenMode": "Borderless Fullscreen"
        },
        "Hotkeys": {
          "SaveStateToSlot": "Keyboard/F1",
          "LoadStateFromSlot": "Keyboard/F3"
        },
        "AutoUpdater": {
          "CheckAtStartup": "false"
        }
      }
    }
  ],
  "import": {
    "roms": [
      "ps2",
      "playstation2"
    ],
    "saves": [
      {
        "from": [
          "pcsx2/memcards",
          "pcsx2/saves"
        ],
        "to": "memcards"
      },
      {
        "from": [
          "pcsx2/sstates",
          "pcsx2/states"
        ],
        "to": "sstates"
      }
    ]
  },
  "quickResume": true,
  "backup": [
    {
      "path": "{saves}/memcards",
      "shared": true
    }
  ],
  "resume": {
    "state": "{saves}/sstates/{serial} (*).resume.p2s",
    "args": [
      "-statefile",
      "{state}"
    ]
  },
  "controls": [
    {
      "type": "ini",
      "file": "{emu}/inis/PCSX2.ini",
      "set": {
        "InputSources": {
          "XInput": "true",
          "SDL": "true"
        },
        "Pad1": {
          "Type": "DualShock2",
          "Up": "{pad}/DPadUp",
          "Right": "{pad}/DPadRight",
          "Down": "{pad}/DPadDown",
          "Left": "{pad}/DPadLeft",
          "Triangle": "{pad}/Y",
          "Circle": "{pad}/B",
          "Cross": "{pad}/A",
          "Square": "{pad}/X",
          "Select": "{pad}/Back",
          "Start": "{pad}/Start",
          "L1": "{pad}/LeftShoulder",
          "L2": "{pad}/+LeftTrigger",
          "R1": "{pad}/RightShoulder",
          "R2": "{pad}/+RightTrigger",
          "L3": "{pad}/LeftStick",
          "R3": "{pad}/RightStick",
          "LUp": "{pad}/-LeftY",
          "LRight": "{pad}/+LeftX",
          "LDown": "{pad}/+LeftY",
          "LLeft": "{pad}/-LeftX",
          "RUp": "{pad}/-RightY",
          "RRight": "{pad}/+RightX",
          "RDown": "{pad}/+RightY",
          "RLeft": "{pad}/-RightX",
          "LargeMotor": "{pad}/LargeMotor",
          "SmallMotor": "{pad}/SmallMotor",
          "Analog": []
        },
        "Hotkeys": {
          "Screenshot": [
            "Keyboard/F12",
            "{padshot}",
            "{padshare}"
          ]
        },
        "Pad2": {
          "Type": "DualShock2",
          "Up": "{pad2}/DPadUp",
          "Right": "{pad2}/DPadRight",
          "Down": "{pad2}/DPadDown",
          "Left": "{pad2}/DPadLeft",
          "Triangle": "{pad2}/Y",
          "Circle": "{pad2}/B",
          "Cross": "{pad2}/A",
          "Square": "{pad2}/X",
          "Select": "{pad2}/Back",
          "Start": "{pad2}/Start",
          "L1": "{pad2}/LeftShoulder",
          "L2": "{pad2}/+LeftTrigger",
          "R1": "{pad2}/RightShoulder",
          "R2": "{pad2}/+RightTrigger",
          "L3": "{pad2}/LeftStick",
          "R3": "{pad2}/RightStick",
          "LUp": "{pad2}/-LeftY",
          "LRight": "{pad2}/+LeftX",
          "LDown": "{pad2}/+LeftY",
          "LLeft": "{pad2}/-LeftX",
          "RUp": "{pad2}/-RightY",
          "RRight": "{pad2}/+RightX",
          "RDown": "{pad2}/+RightY",
          "RLeft": "{pad2}/-RightX",
          "LargeMotor": "{pad2}/LargeMotor",
          "SmallMotor": "{pad2}/SmallMotor",
          "Analog": []
        }
      }
    }
  ],
  "graphics": {
    "original": {
      "steps": [
        {
          "type": "ini",
          "file": "{emu}/inis/PCSX2.ini",
          "set": {
            "EmuCore/GS": {
              "upscale_multiplier": "1"
            }
          }
        }
      ]
    },
    "enhanced": {
      "steps": [
        {
          "type": "ini",
          "file": "{emu}/inis/PCSX2.ini",
          "set": {
            "EmuCore/GS": {
              "upscale_multiplier": "3"
            }
          }
        }
      ]
    },
    "max": {
      "steps": [
        {
          "type": "ini",
          "file": "{emu}/inis/PCSX2.ini",
          "set": {
            "EmuCore/GS": {
              "upscale_multiplier": "6"
            }
          }
        }
      ]
    }
  },
  "patches": [
    {
      "id": "widescreen",
      "label": "Widescreen patch",
      "on": {
        "steps": [
          {
            "type": "ini",
            "file": "{emu}/inis/PCSX2.ini",
            "set": {
              "EmuCore": {
                "EnableWideScreenPatches": "true"
              }
            }
          }
        ]
      },
      "off": {
        "steps": [
          {
            "type": "ini",
            "file": "{emu}/inis/PCSX2.ini",
            "set": {
              "EmuCore": {
                "EnableWideScreenPatches": "false"
              }
            }
          }
        ]
      }
    },
    {
      "id": "nointerlace",
      "label": "No-interlacing patch",
      "on": {
        "steps": [
          {
            "type": "ini",
            "file": "{emu}/inis/PCSX2.ini",
            "set": {
              "EmuCore": {
                "EnableNoInterlacingPatches": "true"
              }
            }
          }
        ]
      },
      "off": {
        "steps": [
          {
            "type": "ini",
            "file": "{emu}/inis/PCSX2.ini",
            "set": {
              "EmuCore": {
                "EnableNoInterlacingPatches": "false"
              }
            }
          }
        ]
      }
    }
  ],
  "mods": {
    "targets": [
      {
        "id": "textures",
        "label": "Texture pack",
        "dir": "{emu}/textures/{serial}",
        "match": "\\.(png|dds|jpg|jpeg|webp)$",
        "anchor": "^replacements$",
        "into": "replacements",
        "enabled": {
          "steps": [
            {
              "type": "ini",
              "file": "{emu}/inis/PCSX2.ini",
              "set": {
                "EmuCore/GS": {
                  "LoadTextureReplacements": "true"
                }
              }
            }
          ]
        },
        "disabled": {
          "steps": [
            {
              "type": "ini",
              "file": "{emu}/inis/PCSX2.ini",
              "set": {
                "EmuCore/GS": {
                  "LoadTextureReplacements": "false"
                }
              }
            }
          ]
        }
      },
      {
        "id": "patches",
        "label": "Patch (.pnach)",
        "dir": "{emu}/patches",
        "match": "\\.pnach$",
        "flatten": true
      },
      {
        "id": "cheats",
        "label": "Cheat (.pnach)",
        "dir": "{emu}/cheats",
        "match": "\\.pnach$",
        "flatten": true,
        "enabled": {
          "steps": [
            {
              "type": "ini",
              "file": "{emu}/inis/PCSX2.ini",
              "set": {
                "EmuCore": {
                  "EnableCheats": "true"
                }
              }
            }
          ]
        },
        "disabled": {
          "steps": [
            {
              "type": "ini",
              "file": "{emu}/inis/PCSX2.ini",
              "set": {
                "EmuCore": {
                  "EnableCheats": "false"
                }
              }
            }
          ]
        }
      }
    ]
  },
  "achievements": {
    "on": [
      {
        "type": "ini",
        "file": "{emu}/inis/PCSX2.ini",
        "set": {
          "Achievements": {
            "Enabled": "true",
            "Username": "{rauser}"
          }
        }
      },
      {
        "type": "ini",
        "file": "{emu}/inis/secrets.ini",
        "set": {
          "Achievements": {
            "Token": "{ratoken}"
          }
        }
      }
    ]
  }
}
