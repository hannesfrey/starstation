{
  "id": "3ds",
  "name": "Nintendo 3DS",
  "short": "3DS",
  "order": 60,
  "icon": "handheld",
  "emulator": "azahar",
  "launch": {
    "args": [
      "-f",
      "{launch}"
    ]
  },
  "extensions": [
    ".3ds",
    ".cci",
    ".cxi",
    ".3dsx",
    ".app",
    ".elf",
    ".axf"
  ],
  "gameId": {
    "method": "filename"
  },
  "saves": {
    "dir": "{saves}",
    "note": "Azahar keeps saves on its virtual SD card; the saves folder links there."
  },
  "import": {
    "roms": [
      "n3ds",
      "3ds"
    ]
  },
  "config": [
    {
      "type": "link",
      "path": "{saves}/sdmc",
      "target": "{emu}/user/sdmc"
    },
    {
      "type": "link",
      "path": "{saves}/nand",
      "target": "{emu}/user/nand"
    },
    {
      "type": "mkdir",
      "path": "{emu}/user/screenshots"
    },
    {
      "type": "link",
      "path": "{screenshots}/azahar",
      "target": "{emu}/user/screenshots"
    }
  ],
  "quickResume": false,
  "notes": "No quick resume: Azahar cannot save a state automatically when it closes. Controller: map it once in Azahar (Emulation → Configure → Controls); Azahar needs the controller's ID, which Starstation can't know beforehand.",
  "backup": [
    {
      "path": "{saves}/sdmc/Nintendo 3DS",
      "shared": true
    }
  ],
  "controls": [
    {
      "type": "ini",
      "file": "{emu}/user/config/qt-config.ini",
      "set": {
        "UI": {
          "Shortcuts\\Main%20Window\\Capture%20Screenshot\\KeySeq\\default": "false",
          "Shortcuts\\Main%20Window\\Capture%20Screenshot\\KeySeq": "F12"
        }
      },
      "spacing": "=",
      "ifExists": true
    }
  ],
  "graphics": {
    "original": {
      "steps": [
        {
          "type": "ini",
          "file": "{emu}/user/config/qt-config.ini",
          "set": {
            "Renderer": {
              "resolution_factor\\default": "false",
              "resolution_factor": "1"
            }
          },
          "spacing": "=",
          "ifExists": true
        }
      ]
    },
    "enhanced": {
      "steps": [
        {
          "type": "ini",
          "file": "{emu}/user/config/qt-config.ini",
          "set": {
            "Renderer": {
              "resolution_factor\\default": "false",
              "resolution_factor": "3"
            }
          },
          "spacing": "=",
          "ifExists": true
        }
      ]
    },
    "max": {
      "steps": [
        {
          "type": "ini",
          "file": "{emu}/user/config/qt-config.ini",
          "set": {
            "Renderer": {
              "resolution_factor\\default": "false",
              "resolution_factor": "5"
            }
          },
          "spacing": "=",
          "ifExists": true
        }
      ]
    }
  }
}
