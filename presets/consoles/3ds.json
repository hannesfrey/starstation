{
  "id": "3ds",
  "name": "Nintendo 3DS",
  "short": "3DS",
  "order": 60,
  "icon": "3ds",
  "emulator": "azahar",
  "launch": {
    "args": [
      "-f",
      "{launch}"
    ]
  },
  "extensions": [
    ".3ds",
    ".cci",
    ".cxi",
    ".3dsx",
    ".app",
    ".elf",
    ".axf"
  ],
  "gameId": {
    "method": "3ds-header"
  },
  "saves": {
    "dir": "{saves}",
    "note": "Azahar keeps saves on its virtual SD card; the saves folder links there."
  },
  "import": {
    "roms": [
      "n3ds",
      "3ds"
    ]
  },
  "config": [
    {
      "type": "link",
      "path": "{saves}/sdmc",
      "target": "{emu}/user/sdmc"
    },
    {
      "type": "link",
      "path": "{saves}/nand",
      "target": "{emu}/user/nand"
    },
    {
      "type": "mkdir",
      "path": "{emu}/user/screenshots"
    },
    {
      "type": "link",
      "path": "{screenshots}/azahar",
      "target": "{emu}/user/screenshots"
    },
    {
      "type": "mii-db",
      "file": "{emu}/user/nand/data/00000000000000000000000000000000/extdata/00048000/F000000B/user/CFL_DB.dat"
    }
  ],
  "quickResume": false,
  "notes": "No quick resume: Azahar cannot save a state automatically when it closes. Controller: Starstation writes Azahar's \"all controllers\" bindings, so any pad works without setup.",
  "backup": [
    {
      "path": "{saves}/sdmc/Nintendo 3DS",
      "shared": true
    }
  ],
  "controls": [
    {
      "type": "ini",
      "file": "{emu}/user/config/qt-config.ini",
      "set": {
        "UI": {
          "Shortcuts\\Main%20Window\\Capture%20Screenshot\\KeySeq\\default": "false",
          "Shortcuts\\Main%20Window\\Capture%20Screenshot\\KeySeq": "F12",
          "pauseWhenInBackground": "false",
          "pauseWhenInBackground\\default": "true",
          "Shortcuts\\Main%20Window\\Continue\\Pause%20Emulation\\KeySeq\\default": "false",
          "Shortcuts\\Main%20Window\\Continue\\Pause%20Emulation\\KeySeq": "F4",
          "confirmClose": "false",
          "confirmClose\\default": "false",
          "saveStateWarning": "false",
          "saveStateWarning\\default": "false"
        },
        "Miscellaneous": {
          "check_for_update_on_start\\default": "false",
          "check_for_update_on_start": "false"
        }
      },
      "spacing": "=",
      "ifExists": true
    },
    {
      "type": "ini",
      "file": "{emu}/user/config/qt-config.ini",
      "set": {
        "Controls": {
          "profiles\\1\\input_maptype": "0",
          "profiles\\1\\input_maptype\\default": "false",
          "profiles\\1\\button_a": "\"api:controller,button:1,engine:sdl,guid:0,maptype:all,port:0\"",
          "profiles\\1\\button_b": "\"api:controller,button:0,engine:sdl,guid:0,maptype:all,port:0\"",
          "profiles\\1\\button_x": "\"api:controller,button:3,engine:sdl,guid:0,maptype:all,port:0\"",
          "profiles\\1\\button_y": "\"api:controller,button:2,engine:sdl,guid:0,maptype:all,port:0\"",
          "profiles\\1\\button_up": "\"api:controller,button:11,engine:sdl,guid:0,maptype:all,port:0\"",
          "profiles\\1\\button_down": "\"api:controller,button:12,engine:sdl,guid:0,maptype:all,port:0\"",
          "profiles\\1\\button_left": "\"api:controller,button:13,engine:sdl,guid:0,maptype:all,port:0\"",
          "profiles\\1\\button_right": "\"api:controller,button:14,engine:sdl,guid:0,maptype:all,port:0\"",
          "profiles\\1\\button_l": "\"api:controller,button:9,engine:sdl,guid:0,maptype:all,port:0\"",
          "profiles\\1\\button_r": "\"api:controller,button:10,engine:sdl,guid:0,maptype:all,port:0\"",
          "profiles\\1\\button_start": "\"api:controller,button:6,engine:sdl,guid:0,maptype:all,port:0\"",
          "profiles\\1\\button_select": "\"api:controller,button:4,engine:sdl,guid:0,maptype:all,port:0\"",
          "profiles\\1\\button_zl": "\"api:controller,axis:4,direction:+,engine:sdl,guid:0,maptype:all,port:0,threshold:0.500000\"",
          "profiles\\1\\button_zr": "\"api:controller,axis:5,direction:+,engine:sdl,guid:0,maptype:all,port:0,threshold:0.500000\"",
          "profiles\\1\\circle_pad": "\"api:controller,axis_x:0,axis_y:1,deadzone:0.100000,engine:sdl,guid:0,maptype:all,port:0\"",
          "profiles\\1\\c_stick": "\"api:controller,axis_x:2,axis_y:3,deadzone:0.100000,engine:sdl,guid:0,maptype:all,port:0\"",
          "profiles\\1\\button_a\\default": "false",
          "profiles\\1\\button_b\\default": "false",
          "profiles\\1\\button_x\\default": "false",
          "profiles\\1\\button_y\\default": "false",
          "profiles\\1\\button_up\\default": "false",
          "profiles\\1\\button_down\\default": "false",
          "profiles\\1\\button_left\\default": "false",
          "profiles\\1\\button_right\\default": "false",
          "profiles\\1\\button_l\\default": "false",
          "profiles\\1\\button_r\\default": "false",
          "profiles\\1\\button_start\\default": "false",
          "profiles\\1\\button_select\\default": "false",
          "profiles\\1\\button_zl\\default": "false",
          "profiles\\1\\button_zr\\default": "false",
          "profiles\\1\\circle_pad\\default": "false",
          "profiles\\1\\c_stick\\default": "false"
        }
      },
      "spacing": "=",
      "ifExists": true
    }
  ],
  "graphics": {
    "original": {
      "steps": [
        {
          "type": "ini",
          "file": "{emu}/user/config/qt-config.ini",
          "set": {
            "Renderer": {
              "resolution_factor\\default": "false",
              "resolution_factor": "1"
            }
          },
          "spacing": "=",
          "ifExists": true
        }
      ]
    },
    "enhanced": {
      "steps": [
        {
          "type": "ini",
          "file": "{emu}/user/config/qt-config.ini",
          "set": {
            "Renderer": {
              "resolution_factor\\default": "false",
              "resolution_factor": "3"
            }
          },
          "spacing": "=",
          "ifExists": true
        }
      ]
    },
    "max": {
      "steps": [
        {
          "type": "ini",
          "file": "{emu}/user/config/qt-config.ini",
          "set": {
            "Renderer": {
              "resolution_factor\\default": "false",
              "resolution_factor": "5"
            }
          },
          "spacing": "=",
          "ifExists": true
        }
      ]
    }
  },
  "mods": {
    "targets": [
      {
        "id": "mods",
        "label": "Game mod (romfs / exefs)",
        "dir": "{emu}/user/load/mods/{titleid}",
        "match": "(^|/)(romfs|exefs)/|\\.ips$|exheader\\.bin$",
        "anchor": "^(romfs|exefs)$"
      },
      {
        "id": "textures",
        "label": "Texture pack",
        "dir": "{emu}/user/load/textures/{titleid}",
        "match": "\\.(png|dds|jpg|jpeg|webp)$",
        "enabled": {
          "steps": [
            {
              "type": "ini",
              "file": "{emu}/user/config/qt-config.ini",
              "set": {
                "Utility": {
                  "custom_textures\\default": "false",
                  "custom_textures": "true"
                }
              },
              "spacing": "=",
              "ifExists": true
            }
          ]
        },
        "disabled": {
          "steps": [
            {
              "type": "ini",
              "file": "{emu}/user/config/qt-config.ini",
              "set": {
                "Utility": {
                  "custom_textures\\default": "false",
                  "custom_textures": "false"
                }
              },
              "spacing": "=",
              "ifExists": true
            }
          ]
        }
      }
    ]
  }
}
