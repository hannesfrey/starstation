{
  "id": "ps3",
  "name": "PlayStation 3",
  "short": "PS3",
  "order": 110,
  "icon": "console-ps3",
  "emulator": "rpcs3",
  "launch": {
    "args": [
      "--no-gui",
      "--fullscreen",
      "{launch}"
    ]
  },
  "extensions": [
    ".iso"
  ],
  "games": {
    "folderMarker": "PS3_GAME/PARAM.SFO",
    "folderLaunch": "PS3_GAME/USRDIR/EBOOT.BIN",
    "installedDir": "{emu}/dev_hdd0/game"
  },
  "bios": {
    "hint": "RPCS3 needs the official PS3 system software (PS3UPDAT.PUP) from playstation.com, installed once.",
    "url": "https://www.playstation.com/en-us/support/hardware/ps3/system-software/",
    "files": [
      {
        "label": "PS3 firmware",
        "match": "",
        "path": "{emu}/dev_flash/vsh/module/vsh.self",
        "required": true,
        "fix": {
          "label": "Install PS3 firmware",
          "command": "install-ps3-firmware"
        }
      }
    ]
  },
  "gameId": {
    "method": "ps3-sfo"
  },
  "saves": {
    "dir": "{saves}",
    "note": "PS3 saves stay inside RPCS3's virtual hard disk; saves\\ps3\\savedata is a link to them."
  },
  "config": [
    {
      "type": "ini",
      "file": "{emu}/GuiConfigs/CurrentSettings.ini",
      "spacing": "=",
      "set": {
        "main_window": {
          "confirmationBoxExitGame": "false",
          "confirmationBoxBootGame": "false",
          "infoBoxEnabledWelcome": "false"
        }
      }
    },
    {
      "type": "mkdir",
      "path": "{emu}/dev_hdd0/home/00000001/savedata"
    },
    {
      "type": "link",
      "path": "{saves}/savedata",
      "target": "{emu}/dev_hdd0/home/00000001/savedata"
    },
    {
      "type": "kv",
      "file": "{emu}/config/vfs.yml",
      "sep": ": ",
      "set": {
        "/dev_hdd0/": "{emu:/}/dev_hdd0/",
        "/games/": "{games:/}/"
      }
    },
    {
      "type": "mkdir",
      "path": "{emu}/screenshots"
    },
    {
      "type": "link",
      "path": "{screenshots}/rpcs3",
      "target": "{emu}/screenshots"
    },
    {
      "type": "kv",
      "file": "{emu}/config/config.yml",
      "sep": ": ",
      "set": {
        "Exclusive Fullscreen Mode": "Prefer borderless fullscreen",
        "Pause emulation on RPCS3 focus loss": "true",
        "Emulated Midi devices": "Keyboardßßß@@@Keyboardßßß@@@Keyboardßßß@@@"
      }
    }
  ],
  "import": {
    "roms": [
      "ps3",
      "playstation3"
    ],
    "storage": [
      {
        "from": [
          "rpcs3/dev_hdd0",
          "rpcs3/hdd0"
        ],
        "to": "{emu}/dev_hdd0"
      }
    ]
  },
  "quickResume": false,
  "shaderHint": true,
  "notes": "Games can be folder dumps (with PS3_GAME), ISOs, or PKG games installed into RPCS3.",
  "backup": [
    {
      "path": "{saves}/savedata/{serial}*"
    }
  ],
  "controls": [
    {
      "type": "yaml-players",
      "file": "{emu}/config/input_configs/global/Default.yml",
      "players": [
        {
          "Handler": "{ps3handler1}",
          "Device": "\"{ps3device1}\""
        },
        {
          "Handler": "{ps3handler2}",
          "Device": "\"{ps3device2}\""
        },
        {
          "Handler": "{ps3handler3}",
          "Device": "\"{ps3device3}\""
        },
        {
          "Handler": "{ps3handler4}",
          "Device": "\"{ps3device4}\""
        }
      ],
      "upTo": "{players}",
      "config": {
        "PS Button": "\"\""
      }
    }
  ],
  "graphics": {
    "original": {
      "steps": [
        {
          "type": "kv",
          "file": "{emu}/config/config.yml",
          "sep": ": ",
          "set": {
            "Resolution Scale": "100"
          }
        }
      ]
    },
    "enhanced": {
      "steps": [
        {
          "type": "kv",
          "file": "{emu}/config/config.yml",
          "sep": ": ",
          "set": {
            "Resolution Scale": "150"
          }
        }
      ]
    },
    "max": {
      "steps": [
        {
          "type": "kv",
          "file": "{emu}/config/config.yml",
          "sep": ": ",
          "set": {
            "Resolution Scale": "200"
          }
        }
      ]
    }
  }
}
