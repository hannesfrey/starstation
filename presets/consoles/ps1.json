{
  "id": "ps1",
  "name": "PlayStation",
  "short": "PS1",
  "order": 90,
  "icon": "console-ps1",
  "emulator": "duckstation",
  "launch": {
    "args": [
      "-batch",
      "-fullscreen",
      "--",
      "{launch}"
    ]
  },
  "extensions": [
    ".cue",
    ".chd",
    ".pbp",
    ".m3u",
    ".iso",
    ".ecm",
    ".mds",
    ".img"
  ],
  "games": {
    "multiDisc": "m3u"
  },
  "bios": {
    "hint": "Any PS1 BIOS dump (512 KB, e.g. SCPH-1001 / SCPH-5502 / SCPH-7502). DuckStation picks the right region automatically.",
    "files": [
      {
        "label": "PS1 BIOS (any region)",
        "match": "\\.(bin|rom|mbx)$",
        "size": [
          524288
        ],
        "required": true
      }
    ]
  },
  "gameId": {
    "method": "ps1-serial",
    "titleDb": {
      "type": "yaml-serial",
      "file": "{emu}/resources/gamedb.yaml"
    }
  },
  "saves": {
    "dir": "{saves}"
  },
  "config": [
    {
      "type": "ini",
      "file": "{emu}/settings.ini",
      "set": {
        "Main": {
          "SetupWizardIncomplete": "false",
          "StartFullscreen": "true",
          "ConfirmPowerOff": "false",
          "SaveStateOnExit": "true",
          "PauseOnFocusLoss": "true"
        },
        "BIOS": {
          "SearchDirectory": "{bios}"
        },
        "MemoryCards": {
          "Directory": "{saves}/memcards"
        },
        "Folders": {
          "SaveStates": "{saves}/savestates",
          "Screenshots": "{screenshots}"
        },
        "GameList": {
          "RecursivePaths": "{games}"
        },
        "Hotkeys": {
          "SaveSelectedSaveState": "Keyboard/F2",
          "LoadSelectedSaveState": "Keyboard/F1"
        }
      }
    }
  ],
  "import": {
    "roms": [
      "psx",
      "ps1",
      "playstation"
    ],
    "saves": [
      {
        "from": [
          "duckstation/memcards",
          "duckstation/saves"
        ],
        "to": "memcards"
      },
      {
        "from": [
          "duckstation/savestates",
          "duckstation/states"
        ],
        "to": "savestates"
      }
    ]
  },
  "quickResume": true,
  "notes": "Multi-disc games: put the discs and a .m3u playlist in one folder; only the .m3u is listed.",
  "backup": [
    {
      "path": "{saves}/memcards",
      "shared": true
    }
  ],
  "resume": {
    "state": "{saves}/savestates/{serial}_resume.sav",
    "args": [
      "-resume"
    ]
  },
  "controls": [
    {
      "type": "ini",
      "file": "{emu}/settings.ini",
      "set": {
        "InputSources": {
          "XInput": "true",
          "SDL": "true"
        },
        "Pad1": {
          "Type": "AnalogController",
          "Up": "{pad}/DPadUp",
          "Right": "{pad}/DPadRight",
          "Down": "{pad}/DPadDown",
          "Left": "{pad}/DPadLeft",
          "Triangle": "{pad}/Y",
          "Circle": "{pad}/B",
          "Cross": "{pad}/A",
          "Square": "{pad}/X",
          "Select": "{pad}/Back",
          "Start": "{pad}/Start",
          "L1": "{pad}/LeftShoulder",
          "L2": "{pad}/+LeftTrigger",
          "R1": "{pad}/RightShoulder",
          "R2": "{pad}/+RightTrigger",
          "L3": "{pad}/LeftStick",
          "R3": "{pad}/RightStick",
          "LUp": "{pad}/-LeftY",
          "LRight": "{pad}/+LeftX",
          "LDown": "{pad}/+LeftY",
          "LLeft": "{pad}/-LeftX",
          "RUp": "{pad}/-RightY",
          "RRight": "{pad}/+RightX",
          "RDown": "{pad}/+RightY",
          "RLeft": "{pad}/-RightX",
          "LargeMotor": "{pad}/LargeMotor",
          "SmallMotor": "{pad}/SmallMotor",
          "Analog": []
        },
        "Hotkeys": {
          "Screenshot": [
            "Keyboard/F12",
            "{padshot}",
            "{padshare}"
          ]
        },
        "Pad2": {
          "Type": "AnalogController",
          "Up": "{pad2}/DPadUp",
          "Right": "{pad2}/DPadRight",
          "Down": "{pad2}/DPadDown",
          "Left": "{pad2}/DPadLeft",
          "Triangle": "{pad2}/Y",
          "Circle": "{pad2}/B",
          "Cross": "{pad2}/A",
          "Square": "{pad2}/X",
          "Select": "{pad2}/Back",
          "Start": "{pad2}/Start",
          "L1": "{pad2}/LeftShoulder",
          "L2": "{pad2}/+LeftTrigger",
          "R1": "{pad2}/RightShoulder",
          "R2": "{pad2}/+RightTrigger",
          "L3": "{pad2}/LeftStick",
          "R3": "{pad2}/RightStick",
          "LUp": "{pad2}/-LeftY",
          "LRight": "{pad2}/+LeftX",
          "LDown": "{pad2}/+LeftY",
          "LLeft": "{pad2}/-LeftX",
          "RUp": "{pad2}/-RightY",
          "RRight": "{pad2}/+RightX",
          "RDown": "{pad2}/+RightY",
          "RLeft": "{pad2}/-RightX",
          "LargeMotor": "{pad2}/LargeMotor",
          "SmallMotor": "{pad2}/SmallMotor",
          "Analog": []
        }
      }
    }
  ],
  "graphics": {
    "original": {
      "steps": [
        {
          "type": "ini",
          "file": "{emu}/settings.ini",
          "set": {
            "GPU": {
              "ResolutionScale": "1",
              "PGXPEnable": "false"
            }
          }
        }
      ]
    },
    "enhanced": {
      "steps": [
        {
          "type": "ini",
          "file": "{emu}/settings.ini",
          "set": {
            "GPU": {
              "ResolutionScale": "4",
              "PGXPEnable": "true"
            }
          }
        }
      ]
    },
    "max": {
      "steps": [
        {
          "type": "ini",
          "file": "{emu}/settings.ini",
          "set": {
            "GPU": {
              "ResolutionScale": "8",
              "PGXPEnable": "true"
            }
          }
        }
      ]
    }
  },
  "patches": [
    {
      "id": "widescreen",
      "label": "Widescreen (16:9)",
      "on": {
        "steps": [
          {
            "type": "ini",
            "file": "{emu}/settings.ini",
            "set": {
              "GPU": {
                "WidescreenHack": "true"
              },
              "Display": {
                "AspectRatio": "16:9"
              }
            }
          }
        ]
      },
      "off": {
        "steps": [
          {
            "type": "ini",
            "file": "{emu}/settings.ini",
            "set": {
              "GPU": {
                "WidescreenHack": "false"
              },
              "Display": {
                "AspectRatio": "Auto (Game Native)"
              }
            }
          }
        ]
      }
    }
  ],
  "mods": {
    "targets": [
      {
        "id": "textures",
        "label": "Texture pack",
        "dir": "{emu}/textures/{serial}",
        "match": "\\.(png|dds|jpg|jpeg|webp)$",
        "anchor": "^replacements$",
        "into": "replacements",
        "enabled": {
          "steps": [
            {
              "type": "ini",
              "file": "{emu}/settings.ini",
              "set": {
                "TextureReplacements": {
                  "EnableTextureReplacements": "true"
                }
              }
            }
          ]
        },
        "disabled": {
          "steps": [
            {
              "type": "ini",
              "file": "{emu}/settings.ini",
              "set": {
                "TextureReplacements": {
                  "EnableTextureReplacements": "false"
                }
              }
            }
          ]
        }
      }
    ]
  },
  "achievements": {
    "on": [
      {
        "type": "ini",
        "file": "{emu}/settings.ini",
        "set": {
          "Cheevos": {
            "Enabled": "true",
            "Username": "{rauser}"
          }
        }
      }
    ]
  }
}
