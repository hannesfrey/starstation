{
  "id": "ps1",
  "name": "PlayStation",
  "short": "PS1",
  "order": 90,
  "icon": "console-ps1",
  "emulator": "duckstation",
  "launch": {
    "args": [
      "-batch",
      "-fullscreen",
      "--",
      "{launch}"
    ]
  },
  "extensions": [
    ".cue",
    ".chd",
    ".pbp",
    ".m3u",
    ".iso",
    ".ecm",
    ".mds",
    ".img"
  ],
  "games": {
    "multiDisc": "m3u"
  },
  "bios": {
    "hint": "Any PS1 BIOS dump (512 KB, e.g. SCPH-1001 / SCPH-5502 / SCPH-7502). DuckStation picks the right region automatically.",
    "files": [
      {
        "label": "PS1 BIOS (any region)",
        "match": "\\.(bin|rom|mbx)$",
        "size": [
          524288
        ],
        "required": true
      }
    ]
  },
  "gameId": {
    "method": "ps1-serial",
    "titleDb": {
      "type": "yaml-serial",
      "file": "{emu}/resources/gamedb.yaml"
    }
  },
  "saves": {
    "dir": "{saves}"
  },
  "config": [
    {
      "type": "ini",
      "file": "{emu}/settings.ini",
      "set": {
        "Main": {
          "SetupWizardIncomplete": "false",
          "StartFullscreen": "true",
          "ConfirmPowerOff": "false",
          "SaveStateOnExit": "true",
          "PauseOnFocusLoss": "true"
        },
        "BIOS": {
          "SearchDirectory": "{bios}"
        },
        "MemoryCards": {
          "Directory": "{saves}/memcards"
        },
        "Folders": {
          "SaveStates": "{saves}/savestates",
          "Screenshots": "{screenshots}"
        },
        "GameList": {
          "RecursivePaths": "{games}"
        },
        "Hotkeys": {
          "SaveSelectedSaveState": "Keyboard/F2",
          "LoadSelectedSaveState": "Keyboard/F1"
        },
        "AutoUpdater": {
          "CheckAtStartup": "false"
        }
      }
    }
  ],
  "import": {
    "roms": [
      "psx",
      "ps1",
      "playstation"
    ],
    "saves": [
      {
        "from": [
          "duckstation/memcards",
          "duckstation/saves"
        ],
        "to": "memcards"
      },
      {
        "from": [
          "duckstation/savestates",
          "duckstation/states"
        ],
        "to": "savestates"
      }
    ]
  },
  "quickResume": true,
  "notes": "Multi-disc games: put the discs and a .m3u playlist in one folder; only the .m3u is listed.",
  "backup": [
    {
      "path": "{saves}/memcards",
      "shared": true
    }
  ],
  "resume": {
    "state": "{saves}/savestates/{serial}_resume.sav",
    "args": [
      "-resume"
    ]
  },
  "controls": [
    {
      "type": "ini",
      "file": "{emu}/settings.ini",
      "set": {
        "InputSources": {
          "XInput": "false",
          "SDL": "true"
        },
        "SDLHints": {
          "SDL_JOYSTICK_RAWINPUT": "1",
          "SDL_XINPUT_ENABLED": "0"
        },
        "Pad1": {
          "Type": "AnalogController",
          "Up": "{sdlpad}/DPadUp",
          "Right": "{sdlpad}/DPadRight",
          "Down": "{sdlpad}/DPadDown",
          "Left": "{sdlpad}/DPadLeft",
          "Triangle": "{sdlpad}/Y",
          "Circle": "{sdlpad}/B",
          "Cross": "{sdlpad}/A",
          "Square": "{sdlpad}/X",
          "Select": "{sdlpad}/Back",
          "Start": "{sdlpad}/Start",
          "L1": "{sdlpad}/LeftShoulder",
          "L2": "{sdlpad}/+LeftTrigger",
          "R1": "{sdlpad}/RightShoulder",
          "R2": "{sdlpad}/+RightTrigger",
          "L3": "{sdlpad}/LeftStick",
          "R3": "{sdlpad}/RightStick",
          "LUp": "{sdlpad}/-LeftY",
          "LRight": "{sdlpad}/+LeftX",
          "LDown": "{sdlpad}/+LeftY",
          "LLeft": "{sdlpad}/-LeftX",
          "RUp": "{sdlpad}/-RightY",
          "RRight": "{sdlpad}/+RightX",
          "RDown": "{sdlpad}/+RightY",
          "RLeft": "{sdlpad}/-RightX",
          "LargeMotor": "{sdlpad}/LargeMotor",
          "SmallMotor": "{sdlpad}/SmallMotor",
          "Analog": []
        },
        "Hotkeys": {
          "Screenshot": [
            "Keyboard/F12",
            "{padshot}",
            "{padshare}"
          ]
        },
        "Pad2": {
          "Type": "AnalogController",
          "Up": "{sdlpad2}/DPadUp",
          "Right": "{sdlpad2}/DPadRight",
          "Down": "{sdlpad2}/DPadDown",
          "Left": "{sdlpad2}/DPadLeft",
          "Triangle": "{sdlpad2}/Y",
          "Circle": "{sdlpad2}/B",
          "Cross": "{sdlpad2}/A",
          "Square": "{sdlpad2}/X",
          "Select": "{sdlpad2}/Back",
          "Start": "{sdlpad2}/Start",
          "L1": "{sdlpad2}/LeftShoulder",
          "L2": "{sdlpad2}/+LeftTrigger",
          "R1": "{sdlpad2}/RightShoulder",
          "R2": "{sdlpad2}/+RightTrigger",
          "L3": "{sdlpad2}/LeftStick",
          "R3": "{sdlpad2}/RightStick",
          "LUp": "{sdlpad2}/-LeftY",
          "LRight": "{sdlpad2}/+LeftX",
          "LDown": "{sdlpad2}/+LeftY",
          "LLeft": "{sdlpad2}/-LeftX",
          "RUp": "{sdlpad2}/-RightY",
          "RRight": "{sdlpad2}/+RightX",
          "RDown": "{sdlpad2}/+RightY",
          "RLeft": "{sdlpad2}/-RightX",
          "LargeMotor": "{sdlpad2}/LargeMotor",
          "SmallMotor": "{sdlpad2}/SmallMotor",
          "Analog": []
        }
      }
    }
  ],
  "graphics": {
    "original": {
      "steps": [
        {
          "type": "ini",
          "file": "{emu}/settings.ini",
          "set": {
            "GPU": {
              "ResolutionScale": "1",
              "PGXPEnable": "false"
            }
          }
        }
      ]
    },
    "enhanced": {
      "steps": [
        {
          "type": "ini",
          "file": "{emu}/settings.ini",
          "set": {
            "GPU": {
              "ResolutionScale": "4",
              "PGXPEnable": "true"
            }
          }
        }
      ]
    },
    "max": {
      "steps": [
        {
          "type": "ini",
          "file": "{emu}/settings.ini",
          "set": {
            "GPU": {
              "ResolutionScale": "8",
              "PGXPEnable": "true"
            }
          }
        }
      ]
    }
  },
  "patches": [
    {
      "id": "widescreen",
      "label": "Widescreen (16:9)",
      "on": {
        "steps": [
          {
            "type": "ini",
            "file": "{emu}/settings.ini",
            "set": {
              "GPU": {
                "WidescreenHack": "true"
              },
              "Display": {
                "AspectRatio": "16:9"
              }
            }
          }
        ]
      },
      "off": {
        "steps": [
          {
            "type": "ini",
            "file": "{emu}/settings.ini",
            "set": {
              "GPU": {
                "WidescreenHack": "false"
              },
              "Display": {
                "AspectRatio": "Auto (Game Native)"
              }
            }
          }
        ]
      }
    }
  ],
  "mods": {
    "targets": [
      {
        "id": "textures",
        "label": "Texture pack",
        "dir": "{emu}/textures/{serial}",
        "match": "\\.(png|dds|jpg|jpeg|webp)$",
        "anchor": "^replacements$",
        "into": "replacements",
        "enabled": {
          "steps": [
            {
              "type": "ini",
              "file": "{emu}/settings.ini",
              "set": {
                "TextureReplacements": {
                  "EnableTextureReplacements": "true"
                }
              }
            }
          ]
        },
        "disabled": {
          "steps": [
            {
              "type": "ini",
              "file": "{emu}/settings.ini",
              "set": {
                "TextureReplacements": {
                  "EnableTextureReplacements": "false"
                }
              }
            }
          ]
        }
      }
    ]
  },
  "achievements": {
    "on": [
      {
        "type": "ini",
        "file": "{emu}/settings.ini",
        "set": {
          "Cheevos": {
            "Enabled": "true",
            "Username": "{rauser}"
          }
        }
      }
    ]
  }
}
